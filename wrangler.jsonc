{
  // Konfigurace Cloudflare Workers.
  //
  // Web je statický a leží v adresáři public/. Worker obsluhuje výhradně
  // /api/* — objednávky, platby a stav objednávky. Všechno ostatní jde
  // přímo ze statických souborů a Worker se u toho vůbec nespustí.
  //
  // Požadavky na statické soubory se neúčtují ani nepočítají do limitu
  // Workeru; platí se jen volání /api/*.

  "name": "collectiversium",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-24",

  "assets": {
    // Povolovací režim: publikuje se JEN obsah public/. Serverový kód,
    // schéma databáze, build skripty a zdrojové fotky leží mimo, takže
    // je nejde stáhnout — ani omylem, až přibude nový soubor.
    "directory": "./public",
    // Přístup Workeru ke statickým souborům (env.ASSETS).
    "binding": "ASSETS",
    // Bez tohohle by statické soubory obsloužily i /api/* a Worker by se
    // nespustil. Tenhle řádek je to, co dělá z webu e-shop.
    // "/" je tu kvůli html_handling: "none" níže — v tom režimu Cloudflare
    // sám neví, že kořen je index.html, takže to dořeší Worker.
    "run_worker_first": ["/api/*", "/"],
    // Neexistující stránka vrátí 404.html místo holé hlášky.
    "not_found_handling": "404-page",
    // Výchozí chování přesměrovává /kontakt.html → /kontakt. Sitemap,
    // canonical URL i Search Console ale znají adresy s .html, takže by
    // každá indexovaná stránka mířila na přesměrování. Necháváme je být.
    "html_handling": "none"
  },

  "observability": {
    "enabled": true
  }

  // Až bude hotová databáze objednávek, přibude sem binding na D1:
  //
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "collectiversium", "database_id": "..." }
  // ]
  //
  // Tajemství (GOPAY_CLIENT_SECRET a spol.) se sem NIKDY nepíšou —
  // patří do Secrets v nastavení Workeru.
}
